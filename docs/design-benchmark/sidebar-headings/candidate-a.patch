+
+/* The rail from daisyUI navbar, stat, menu, and badge (candidate A, kept 2026-11-20). */
+.rail-bar {
+	min-height: 0;
+	padding: var(--spacing-4px) 0 var(--spacing-16px) var(--spacing-12px);
+}
+.rail .wordmark {
+	display: inline-flex;
+	align-items: baseline;
+	font-size: var(--text-step-13);
+	line-height: 1.1;
+}
+.rail .btn-ghost {
+	font-weight: 500;
+}
+.forecast.stats {
+	display: grid;
+	width: 100%;
+	border: var(--border) solid var(--site-field-border);
+	background-color: var(--color-base-100);
+}
+.forecast .stat {
+	row-gap: var(--spacing-2px);
+	padding: var(--spacing-12px) var(--spacing-14px);
+}
+.forecast :is(.stat-title, .stat-desc) {
+	white-space: normal;
+	font-size: var(--text-step-4);
+	color: var(--color-muted);
+}
+.forecast .stat-value {
+	display: flex;
+	flex-wrap: wrap;
+	align-items: center;
+	gap: var(--spacing-8px);
+	white-space: normal;
+	font-family: var(--font-display);
+	font-weight: var(--font-weight-heading);
+	font-size: var(--text-step-12);
+	line-height: 1.25;
+	margin-bottom: var(--spacing-3px);
+}
+.rail .badge {
+	font-family: var(--font-body);
+	font-weight: 600;
+}
+.rail .rail-section {
+	margin-top: var(--spacing-20px);
+}
+.rail .menu {
+	padding: 0;
+	font-size: var(--text-step-9);
+	line-height: 1.35;
+}
+.rail .menu .sub {
+	display: block;
+	margin-top: var(--spacing-3px);
+	font-size: var(--text-step-4);
+	color: var(--color-muted);
+}
+/* The heading outranks its rows: ink, weight, and a step up in size. */
+.rail .menu-title {
+	padding-block: var(--spacing-4px) var(--spacing-6px);
+	color: var(--color-base-content);
+	font-size: var(--text-step-11);
+	font-weight: 600;
+	line-height: 1.3;
+}
+.rail .menu li > .rail-static {
+	display: block;
+	cursor: default;
+}
+.rail .menu li > .rail-static:hover {
+	background-color: transparent;
+}
+.rail .menu li.waiting-row {
+	flex-flow: row wrap;
+	align-items: center;
+	justify-content: space-between;
+}
+.rail .menu li.waiting-row > a:first-child {
+	flex: 1 1 auto;
+}
+.rail .menu .term-link {
+	padding-inline: var(--spacing-8px);
+	font-size: var(--text-step-4);
+	color: var(--color-muted);
+}
+.rail .menu .release-head {
+	display: flex;
+	align-items: center;
+	gap: var(--spacing-8px);
+}
+.rail .menu .release + .release {
+	margin-top: var(--spacing-8px);
+}
+.rail .menu .round-link {
+	display: block;
+}
+.rail .menu .round-link .figures {
+	display: flex;
+}
+.rail .menu li.release {
+	padding: 0;
+}

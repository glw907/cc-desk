#!/usr/bin/env bash
# Opens one cc-desk://<project>/<round> address in a terminal.
#
# The desktop hands this script the address unchanged, as its one argument. It runs
# `ptyxis -x "<cc-desk> <project> <round>"` only when both names match [a-z0-9][a-z0-9-]*, and
# refuses every other address with exit 2. A name can't start with "-", so it can't reach cc-desk
# as a flag.
set -euo pipefail
# Under a UTF-8 locale [a-z] can match accented letters.
export LC_ALL=C

refuse() {
	echo "cc-desk-open: refused: $1" >&2
	exit 2
}

(( $# == 1 )) || refuse "takes one address"

re='^cc-desk://([a-z0-9][a-z0-9-]*)/([a-z0-9][a-z0-9-]*)$'
[[ $1 =~ $re ]] || refuse "not a cc-desk://<project>/<round> address"
# The path check below runs a second match, which overwrites BASH_REMATCH.
project=${BASH_REMATCH[1]}
round=${BASH_REMATCH[2]}

cc=$(command -v cc-desk) || refuse "cc-desk is not on PATH"
# ptyxis splits the -x string like a shell.
[[ $cc =~ ^/[A-Za-z0-9._/-]+$ ]] || refuse "cc-desk path has characters ptyxis would split"

# The command is named by absolute path because ptyxis runs it in its own service, whose PATH
# isn't this script's.
ptyxis -x "$cc $project $round"
